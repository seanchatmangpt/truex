{
  "name": "truex-membrane",
  "version": "26.5.25-CONVERGED",
  "description": "Receipted operational manufacturing substrate for deterministic consequence, replay, and capability closure",
  "repository": "https://github.com/seanchatmangpt/truex",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "pnpm build:root && pnpm -r --if-present build",
    "dev": "vitest dev",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "automd && eslint . --fix && prettier -w .",
    "prepack": "npm run build",
    "play": "jiti playground",
    "release": "npm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "vitest run",
    "test:full": "vitest run && pnpm doctor:ecosystem && pnpm doctor:mailbox && pnpm doctor:finalization",
    "test:types": "tsc --noEmit --skipLibCheck",
    "truex": "tsx scripts/truex.ts",
    "doctor:capability": "TSX_DISABLE_CACHE=1 tsx scripts/prove-doctor-capability.ts",
    "doctor:ecosystem": "pnpm doctor:capability -- ecosystem",
    "doctor:mailbox": "pnpm doctor:capability -- mailbox",
    "doctor:finalization": "pnpm doctor:capability -- finalization",
    "doctor:ggen-bblock": "TSX_DISABLE_CACHE=1 tsx scripts/prove-ggen-bblock.ts",
    "proof:genesis": "TSX_DISABLE_CACHE=1 tsx examples/genesis-foundry.ts",
    "observatory": "TSX_DISABLE_CACHE=1 tsx scripts/observatory/index.ts",
    "finalization:12h": "pnpm doctor:ecosystem && pnpm doctor:mailbox && pnpm doctor:finalization && pnpm observatory",
    "build:root": "unbuild",
    "capabilities": "tsx scripts/capabilities.ts map",
    "capabilities:verify": "tsx scripts/capabilities.ts verify",
    "capabilities:prove": "tsx scripts/capabilities.ts prove --all",
    "ci": "pnpm lint && pnpm test:types && pnpm capabilities:verify && pnpm build && pnpm vitest run --coverage"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@rolldown/binding-darwin-arm64": "^1.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.7",
    "automd": "^0.3.12",
    "changelogen": "^0.5.7",
    "eslint": "^9.15.0",
    "eslint-config-unjs": "^0.4.2",
    "fast-check": "^4.8.0",
    "jiti": "^2.4.0",
    "prettier": "^3.4.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "unbuild": "^2.0.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.14.2",
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@noble/post-quantum": "^0.6.1",
    "better-sqlite3": "^12.10.0",
    "citty": "^0.2.2",
    "unctx": "^2.4.0"
  }
}
