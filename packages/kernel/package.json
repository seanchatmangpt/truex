{
  "name": "@truex/kernel",
  "version": "26.5.25-CONVERGED",
  "description": "Core kernel and runtime utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@truex/contracts": "workspace:*",
    "@truex/membrane": "workspace:*",
    "@truex/kernel-wasm": "workspace:*",
    "@truex/ml": "workspace:*",
    "@truex/planner": "workspace:*",
    "blake3": "^2.1.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "kernel",
    "runtime",
    "utilities"
  ],
  "author": "Sean Chatman",
  "license": "SEE LICENSE IN LICENSE"
}
